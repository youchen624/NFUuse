<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE PersonData [
<!ELEMENT PersonData (name,birthday,occupation+,spouse?,email*,salary*,phone*)>
<!ELEMENT name (#PCDATA)>
<!ELEMENT birthday (#PCDATA)>
<!ELEMENT occupation (#PCDATA)>
<!ELEMENT spouse (#PCDATA)>
<!ELEMENT email (#PCDATA)>
<!ELEMENT salary (#PCDATA)>
<!ELEMENT phone (#PCDATA)>
<!ATTLIST PersonData sex CDATA #REQUIRED>
<!ATTLIST spouse sex CDATA #REQUIRED>
<!ATTLIST email space CDATA #IMPLIED>
<!ATTLIST salary currency CDATA #FIXED "NT$">
  
]>
