`timescale 1 ps/ 1 ps
module test01_vlg_vec_tst();
// constants                                           
// general purpose registers
reg CLK;
reg CLR;
reg [3:0] i;
reg PRS;
// wires                                               
wire [3:0] d;

// assign statements (if any)                          
test01 i1 (
// port map - connection between master ports and signals/registers   
	.CLK(CLK),
	.CLR(CLR),
	.d(d),
	.i(i),
	.PRS(PRS)
);
initial 
begin 
#1000000 $finish;
end 

// CLK
always
begin
	CLK = 1'b0;
	CLK = #2500 1'b1;
	#2500;
end 

// CLR
initial
begin
	CLR = 1'b1;
	CLR = #20000 1'b0;
	CLR = #40000 1'b1;
end 
// i[ 3 ]
initial
begin
	repeat(12)
	begin
		i[3] = 1'b0;
		i[3] = #40000 1'b1;
		# 40000;
	end
	i[3] = 1'b0;
end 
// i[ 2 ]
always
begin
	i[2] = 1'b0;
	i[2] = #20000 1'b1;
	#20000;
end 
// i[ 1 ]
always
begin
	i[1] = 1'b0;
	i[1] = #10000 1'b1;
	#10000;
end 
// i[ 0 ]
always
begin
	i[0] = 1'b0;
	i[0] = #5000 1'b1;
	#5000;
end 

// PRS
initial
begin
	PRS = 1'b1;
end 
endmodule

