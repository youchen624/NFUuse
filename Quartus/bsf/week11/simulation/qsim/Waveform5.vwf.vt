`timescale 1 ps/ 1 ps
module special_conventer_vlg_vec_tst();
// constants                                           
// general purpose registers
reg i0;
reg i1;
reg i2;
reg i3;
// wires                                               
wire o0;
wire o1;
wire o2;
wire o3;

// assign statements (if any)                          
special_conventer i1 (
// port map - connection between master ports and signals/registers   
	.i0(i0),
	.i1(i1),
	.i2(i2),
	.i3(i3),
	.o0(o0),
	.o1(o1),
	.o2(o2),
	.o3(o3)
);
initial 
begin 
#1000000 $finish;
end 

// i0
always
begin
	i0 = 1'b0;
	i0 = #10000 1'b1;
	#10000;
end 

// i1
always
begin
	i1 = 1'b0;
	i1 = #20000 1'b1;
	#20000;
end 

// i2
initial
begin
	repeat(12)
	begin
		i2 = 1'b0;
		i2 = #40000 1'b1;
		# 40000;
	end
	i2 = 1'b0;
end 

// i3
initial
begin
	repeat(6)
	begin
		i3 = 1'b0;
		i3 = #80000 1'b1;
		# 80000;
	end
	i3 = 1'b0;
end 
endmodule

