`timescale 1 ps/ 1 ps
module main_vlg_vec_tst();
// constants                                           
// general purpose registers
reg [3:0] i;
// wires                                               
wire [6:0] o;
wire t0;
wire t1;
wire t2;
wire t3;

// assign statements (if any)                          
main i1 (
// port map - connection between master ports and signals/registers   
	.i(i),
	.o(o),
	.t0(t0),
	.t1(t1),
	.t2(t2),
	.t3(t3)
);
initial 
begin 
#1000000 $finish;
end 
// i[ 3 ]
initial
begin
	repeat(6)
	begin
		i[3] = 1'b0;
		i[3] = #80000 1'b1;
		# 80000;
	end
	i[3] = 1'b0;
end 
// i[ 2 ]
initial
begin
	repeat(12)
	begin
		i[2] = 1'b0;
		i[2] = #40000 1'b1;
		# 40000;
	end
	i[2] = 1'b0;
end 
// i[ 1 ]
always
begin
	i[1] = 1'b0;
	i[1] = #20000 1'b1;
	#20000;
end 
// i[ 0 ]
always
begin
	i[0] = 1'b0;
	i[0] = #10000 1'b1;
	#10000;
end 
endmodule

