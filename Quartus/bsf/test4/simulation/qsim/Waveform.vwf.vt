`timescale 1 ps/ 1 ps
module test4_vlg_vec_tst();
// constants                                           
// general purpose registers
reg A;
reg B;
reg C;
reg G1;
reg G2AN;
reg G2BN;
// wires                                               
wire Y0N;
wire Y1N;
wire Y2N;
wire Y3N;
wire Y4N;
wire Y5N;
wire Y6N;
wire Y7N;

// assign statements (if any)                          
test4 i1 (
// port map - connection between master ports and signals/registers   
	.A(A),
	.B(B),
	.C(C),
	.G1(G1),
	.G2AN(G2AN),
	.G2BN(G2BN),
	.Y0N(Y0N),
	.Y1N(Y1N),
	.Y2N(Y2N),
	.Y3N(Y3N),
	.Y4N(Y4N),
	.Y5N(Y5N),
	.Y6N(Y6N),
	.Y7N(Y7N)
);
initial 
begin 
#1000000 $finish;
end 

// A
always
begin
	A = 1'b0;
	A = #10000 1'b1;
	#10000;
end 

// B
always
begin
	B = 1'b0;
	B = #20000 1'b1;
	#20000;
end 

// C
initial
begin
	repeat(16)
	begin
		C = 1'b0;
		C = #30000 1'b1;
		# 30000;
	end
	C = 1'b0;
	C = #30000 1'b1;
end 

// G1
initial
begin
	G1 = 1'b1;
end 

// G2AN
initial
begin
	G2AN = 1'b0;
end 

// G2BN
initial
begin
	G2BN = 1'b0;
end 
endmodule

