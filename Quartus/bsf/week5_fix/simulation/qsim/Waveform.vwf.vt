`timescale 1 ps/ 1 ps
module main_test_vlg_vec_tst();
// constants                                           
// general purpose registers
reg [0:3] tta;
reg [0:1] tts;
// wires                                               
wire tty;

// assign statements (if any)                          
main_test i1 (
// port map - connection between master ports and signals/registers   
	.tta(tta),
	.tts(tts),
	.tty(tty)
);
initial 
begin 
#1000000 $finish;
end 
// tta[ 3 ]
initial
begin
	tta[3] = 1'b0;
	tta[3] = #320000 1'b1;
	tta[3] = #320000 1'b0;
	tta[3] = #320000 1'b1;
end 
// tta[ 2 ]
initial
begin
	repeat(3)
	begin
		tta[2] = 1'b0;
		tta[2] = #160000 1'b1;
		# 160000;
	end
	tta[2] = 1'b0;
end 
// tta[ 1 ]
initial
begin
	repeat(6)
	begin
		tta[1] = 1'b0;
		tta[1] = #80000 1'b1;
		# 80000;
	end
	tta[1] = 1'b0;
end 
// tta[ 0 ]
